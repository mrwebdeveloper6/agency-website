// ==============================================================================
// PRISMA SCHEMA DEFINITION - APEXLOGIC DIGITAL ENGINEERING LLC
// Enterprise-Grade PostgreSQL Database Schema
// Optimized for High-Throughput Lead Capture, Analytics, Portfolio & Security Audits
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum LeadStatus {
  NEW_UNQUALIFIED
  QUALIFYING
  TECHNICAL_REVIEW
  PROPOSAL_SENT
  WON_ACTIVE_CONTRACT
  DISQUALIFIED
  ARCHIVED
}

enum ProjectCategory {
  CUSTOM_WEB_APPLICATION
  ENTERPRISE_SOFTWARE
  RAPID_MVP_SAAS
  AUTONOMOUS_AI_AGENTS
  UI_UX_PROTOTYPING
  API_SYSTEMS_INTEGRATION
  CLOUD_SECURITY_DEVSECOPS
}

enum BudgetRange {
  TIER_1_15K_TO_30K       // Rapid MVP / Proof of Concept
  TIER_2_30K_TO_75K       // Scaled Platform / AI Agent Mesh
  TIER_3_75K_TO_200K      // Enterprise Architecture / Multi-Tenant Core
  TIER_4_200K_PLUS        // Full Digital Transformation / Tier-1 Retainer
}

enum TargetTimeline {
  IMMEDIATE_UNDER_4_WEEKS // High-velocity sprint
  STANDARD_1_TO_3_MONTHS
  STRATEGIC_3_TO_6_MONTHS
  LONG_TERM_ROADMAP
}

enum ComplianceRequirement {
  NONE
  SOC2_TYPE_II
  HIPAA_BAA
  PCI_DSS_L1
  GDPR_CCPA
  ISO_27001
}

// ------------------------------------------------------------------------------
// LEAD CAPTURE & ENTERPRISE INQUIRIES
// ------------------------------------------------------------------------------

model Lead {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  
  // Client Identity
  fullName              String
  workEmail             String
  phoneNumber           String?
  companyName           String
  companyRole           String                 // e.g. "CTO", "Founder & CEO", "VP Engineering"
  companyWebsite        String?
  companySize           String?                // e.g. "1-10", "11-50", "51-250", "250+"

  // Project Specs
  category              ProjectCategory
  budgetRange           BudgetRange
  timeline              TargetTimeline
  complianceNeeded      ComplianceRequirement  @default(NONE)
  projectDescription    String                 @db.Text
  existingTechStack     String?                // e.g. "React, Node.js, AWS RDS"
  
  // AI-Assisted Assessment & Qualification
  aiEstimatedVelocity   String?                // e.g. "3 Sprints (6 Weeks)"
  aiTechnicalComplexity String?                // "High (Multi-tenant + RAG pipeline)"
  aiArchitecturalNotes  String?                @db.Text
  qualificationScore    Int                    @default(70) // 1-100 score
  
  // Sales & Workflow
  status                LeadStatus             @default(NEW_UNQUALIFIED)
  internalNotes         String?                @db.Text
  assignedEngineerEmail String?
  ndaSigned             Boolean                @default(false)
  discoveryCallDate     DateTime?

  // Audit Tracking
  ipAddressHash         String?
  userAgent             String?
  referrerSource        String?

  @@index([workEmail])
  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ------------------------------------------------------------------------------
// SERVICES & CAPABILITIES CATALOG
// ------------------------------------------------------------------------------

model Service {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique
  title                 String
  tagline               String
  description           String                 @db.Text
  proofMetric           String                 // e.g. "75% Operational Acceleration"
  deliverablesSummary   String[]
  techStackTags         String[]
  slaCommitment         String                 // e.g. "99.99% Uptime / <1-Hour Incident Response"
  isCore                Boolean                @default(true)
  displayOrder          Int                    @default(0)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("services")
}

// ------------------------------------------------------------------------------
// CASE STUDIES & VERIFIED IMPACT
// ------------------------------------------------------------------------------

model CaseStudy {
  id                    String                 @id @default(uuid())
  slug                  String                 @unique
  clientName            String
  industry              String                 // e.g. "FinTech", "HealthTech", "Supply Chain"
  headline              String
  challengeSummary      String                 @db.Text
  solutionArchitecture  String                 @db.Text
  primaryMetric         String                 // e.g. "45,000 QPS Sustained"
  secondaryMetric       String                 // e.g. "-68% Cloud Infrastructure Waste"
  technologies          String[]
  clientQuote           String?                @db.Text
  clientReviewerName    String?                // e.g. "Marcus Vance"
  clientReviewerTitle   String?                // e.g. "Chief Technology Officer"
  clutchRating          Float?                 @default(5.0)
  isFeatured            Boolean                @default(true)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("case_studies")
}

// ------------------------------------------------------------------------------
// TELEMETRY, WAF HEALTH & VISITOR ANALYTICS
// ------------------------------------------------------------------------------

model SystemHealthLog {
  id                    String                 @id @default(uuid())
  timestamp             DateTime               @default(now())
  endpointTested        String                 @default("/api/health")
  statusCode            Int                    @default(200)
  responseTimeMs        Float
  memoryUsedMb          Float
  wafStatus             String                 @default("ACTIVE_PROTECT")
  rateLimitLoadPercent  Float                  @default(12.4)
  activeInstances       Int                    @default(3)

  @@index([timestamp])
  @@map("system_health_logs")
}

model AnalyticsEvent {
  id                    String                 @id @default(uuid())
  timestamp             DateTime               @default(now())
  eventType             String                 // e.g. "ESTIMATOR_COMPLETED", "LEAD_SUBMITTED", "WHITEPAPER_VIEWED"
  sessionFingerprint    String
  pagePath              String
  metadata              Json?

  @@index([eventType, timestamp])
  @@map("analytics_events")
}
